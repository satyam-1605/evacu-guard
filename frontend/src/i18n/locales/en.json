  "about": {
    "title": "About EvacuGuard",
    "problem": {
      "title": "The Problem",
      "p1": "Jaipur faces severe flooding during monsoon season every year. Flash floods, waterlogged roads, and sudden infrastructure failures catch citizens off-guard. Historically, casualties have resulted not from the disasters themselves but from the lack of real-time, coordinated information to guide evacuations.",
      "p2": "Emergency services struggle with fragmented communication, outdated maps, and delayed response. There is no unified platform that connects weather data, citizen reports, and shelter availability into a single actionable dashboard."
    },
    "solution": {
      "title": "Our Solution",
      "p1": "EvacuGuard is a real-time disaster management platform built specifically for Jaipur. It fuses live weather data from Open-Meteo, citizen hazard reports, and ML-based flood risk scoring into a live operational dashboard used by both citizens and administrators.",
      "p2": "AI-powered routing calculates the safest evacuation paths around live hazards. Real-time WebSocket alerts notify users the moment conditions change. Citizen participation via the hazard report form feeds directly into the risk engine, making every user a first responder."
    },
